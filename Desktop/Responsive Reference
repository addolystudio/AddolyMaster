/* ==========================================
        1. Pure CSS — responsive.css
   ========================================== */
/*
 * Responsive Design Reference
 * ===========================
 * Approach: Mobile-First
 *
 * Breakpoints:
 * Mobile        : Default
 * Tablet        : 768px and above
 * Desktop       : 992px and above
 * Large Desktop : 1200px and above
 */

/* ==========================================
   1. Base / Mobile Styles
   ========================================== */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 100%;
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #222222;
  background-color: #ffffff;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

/* Responsive Grid */
.responsive-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

/* Responsive Flex Layout */
.responsive-flex {
  display: flex;
  flex-direction: column;
  gap: 16px;
}


/* ==========================================
   2. Tablet Styles
   768px and above
   ========================================== */

@media only screen and (min-width: 768px) {

  body {
    font-size: 16px;
  }

  .container {
    padding: 0 24px;
  }

  .responsive-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .responsive-flex {
    flex-direction: row;
    align-items: center;
  }
}


/* ==========================================
   3. Desktop / Laptop Styles
   992px and above
   ========================================== */

@media only screen and (min-width: 992px) {

  body {
    font-size: 18px;
  }

  .container {
    padding: 0 32px;
  }

  .responsive-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
}


/* ==========================================
   4. Large Desktop Styles
   1200px and above
   ========================================== */

@media only screen and (min-width: 1200px) {

  body {
    background-color: #f4f4f4;
  }

  .container {
    padding: 0;
  }

  .responsive-grid {
    gap: 32px;
  }
}


/* ==========================================
   Required HTML Viewport Meta Tag

Add this inside the <head> of every HTML page:
   ========================================== */

<meta name="viewport" content="width=device-width, initial-scale=1.0">


/* ==========================================
        2. Tailwind CSS — index.htm
Tailwind CSS uses responsive utility prefixes instead of writing traditional media queries for most responsive layouts.
   ========================================== */

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Responsive Tailwind CSS</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-white text-gray-900">

  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Responsive Heading -->
    <section class="py-8 md:py-12 lg:py-16">

      <h1
        class="
          text-2xl
          font-bold
          sm:text-3xl
          md:text-4xl
          lg:text-5xl
        "
      >
        Responsive Website
      </h1>

      <p
        class="
          mt-4
          max-w-2xl
          text-sm
          text-gray-600
          sm:text-base
          lg:text-lg
        "
      >
        A mobile-first responsive layout built
        with Tailwind CSS.
      </p>

    </section>


    <!-- Responsive Grid -->
    <section
      class="
        grid
        grid-cols-1
        gap-4
        sm:grid-cols-2
        lg:grid-cols-3
        xl:gap-6
      "
    >

      <!-- Card -->
      <article class="rounded-xl bg-gray-100 p-6 shadow-sm">

        <h2 class="text-xl font-semibold">
          Mobile
        </h2>

        <p class="mt-2 text-gray-600">
          One-column layout for smaller screens.
        </p>

      </article>


      <!-- Card -->
      <article class="rounded-xl bg-gray-100 p-6 shadow-sm">

        <h2 class="text-xl font-semibold">
          Tablet
        </h2>

        <p class="mt-2 text-gray-600">
          Two-column layout for medium screens.
        </p>

      </article>


      <!-- Card -->
      <article class="rounded-xl bg-gray-100 p-6 shadow-sm">

        <h2 class="text-xl font-semibold">
          Desktop
        </h2>

        <p class="mt-2 text-gray-600">
          Three-column layout for larger screens.
        </p>

      </article>

    </section>

  </main>

</body>

</html>

/* ==========================================
       Tailwind Responsive Pattern
   ========================================== */
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">

/* ==========================================
            This means:
   ========================================== */
Mobile   → 1 column
Small    → 2 columns
Desktop  → 3 columns

